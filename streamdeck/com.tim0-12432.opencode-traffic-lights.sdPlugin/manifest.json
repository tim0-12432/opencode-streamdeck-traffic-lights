{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "OpenCode Traffic Lights",
	"Version": "1.0.0.0",
	"Author": "tim0-12432",
	"Description": "Mirrors your OpenCode agent's status to a Stream Deck key: green when idle, yellow when it needs your input, red while it works.",
	"URL": "https://github.com/tim0-12432/opencode-traffic-lights",
	"SupportURL": "https://github.com/tim0-12432/opencode-traffic-lights/issues",
	"Actions": [
		{
			"Name": "OpenCode Status",
			"UUID": "com.tim0-12432.opencode-traffic-lights.status",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Displays the status of your OpenCode session.",
			"PropertyInspectorPath": "ui/status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key"
				}
			]
		}
	],
	"Category": "OpenCode Traffic Lights",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "disabled"
	},
	"UUID": "com.tim0-12432.opencode-traffic-lights"
}
