{
  "name": "@tim0-12432/opencode-traffic-lights",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCode agent status mirrored to an Elgato Stream Deck key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter ./streamdeck run build",
    "watch": "pnpm --filter ./streamdeck run watch",
    "relink": "pnpm --filter ./streamdeck run relink",
    "validate": "pnpm --filter ./streamdeck run validate",
    "tsc": "pnpm -r --fail-if-no-match run tsc",
    "test": "pnpm -r --fail-if-no-match run test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.10",
    "@types/node": "24.1.0",
    "typescript": "5.9.3"
  }
}
