node_modules

# Stream Deck files
# The bundle is generated by `pnpm build`; it must not be committed. That
# includes the `{ "type": "module" }` package.json that `rollup.config.mjs`
# emits INTO bin/, next to `output.file` -- Node needs it to read
# `bin/plugin.js` as ESM, but it is generated on every build, so it stays
# ignored with the rest of bin/ and is never committed.
*.sdPlugin/bin
# Runtime logs contain the user's device ids and OS build.
*.sdPlugin/logs

# Build output and caches
dist/
*.tsbuildinfo
streamdeck/test/.build/
opencode/test/.build/

.DS_Store
